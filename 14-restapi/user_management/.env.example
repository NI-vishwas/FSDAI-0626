FLASK_ENV=development
FLASK_DEBUG=True
# Used by `flask run`
FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=5000

# Used by `python run.py`
APP_HOST=0.0.0.0
APP_PORT=5000

# Use a long random value in production
SECRET_KEY=replace-with-very-long-random-secret
JWT_SECRET_KEY=replace-with-different-very-long-random-secret

# MySQL connection
DB_USER=app_user
DB_PASSWORD=strong-db-password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=app2_db

# Security and API behavior
CORS_ORIGINS=http://localhost:3000
RATELIMIT_DEFAULT=200 per day;50 per hour
JWT_ACCESS_TOKEN_EXPIRES_MIN=30
FORCE_HTTPS=False
