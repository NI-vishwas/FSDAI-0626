PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.4xj6v.mongodb.net/<dbname>?retryWrites=true&w=majority
JWT_SECRET=replace_with_shared_secret
# Flask-friendly alias also supported by this API middleware:
# JWT_SECRET_KEY=replace_with_shared_secret
# For RS256 tokens from Flask auth service, set JWT_PUBLIC_KEY instead of JWT_SECRET
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\\n...\\n-----END PUBLIC KEY-----"
JWT_ISSUER=
JWT_AUDIENCE=
JWT_ALGORITHMS=HS256
# Flask-style alias also supported:
# JWT_ALGORITHM=HS256